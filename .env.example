# NVIDIA API key — obtain one from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA model identifier
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional trusted-LAN mode for phone access during development.
# Keep the backend on 127.0.0.1. Set a long random token, then run Vite with
# DEVPILOT_LAN_ENABLED=true; Vite proxies API calls and does not expose token
# values in browser JavaScript. Never expose this development server publicly.
# DEVPILOT_LAN_ENABLED=true
# DEVPILOT_API_TOKEN=replace-with-a-long-random-secret
# DEVPILOT_API_PROXY_TARGET=http://127.0.0.1:8000

# Future self-hosted production mode (Phase 0 contract only; do not enable
# until PostgreSQL and a disposable worker runtime are configured).
# DEVPILOT_RUNTIME_MODE=self_hosted_production
# DEVPILOT_DATABASE_URL=postgresql://devpilot:replace-me@127.0.0.1/devpilot
# DEVPILOT_WORKER_RUNTIME=container
# DEVPILOT_WORKER_IMAGE=devpilot-worker:0.1

# Local Docker PostgreSQL bootstrap. Store the real password only in the
# ignored .env file; never commit it. See docs/DOCKER_SELF_HOSTED_SETUP.md.
# DEVPILOT_POSTGRES_PASSWORD=replace-with-a-unique-local-password
# DEVPILOT_POSTGRES_PORT=55432

# Phase 2 read-only webhook ingress. This endpoint stays disabled until both
# variables are configured locally. Do not commit this secret or a public URL.
# DEVPILOT_GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Future GitHub App read-only identity. Keep the private key outside this
# repository and reference only its absolute .pem path. See
# docs/GITHUB_APP_READ_ONLY_SETUP.md.
# DEVPILOT_GITHUB_APP_ENABLED=false
# DEVPILOT_GITHUB_APP_ID=123456
# DEVPILOT_GITHUB_INSTALLATION_ID=12345678
# DEVPILOT_GITHUB_APP_PRIVATE_KEY_PATH=C:\\Users\\ayush\\DevPilot-Secrets\\devpilot-github-app.pem
